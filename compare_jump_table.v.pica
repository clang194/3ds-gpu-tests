.fvec projection[4], lowColor, midColor, highColor
.setb b14 true
.constf basis(0.0, 1.0, -1.0, 0.3333333432674408)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.alias inpos v0
.alias inarg v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov r15, basis.wwww
	cmp inarg, lt, gt, r15
	jmpc cmp.x, low_path
	jmpc cmp.y, high_path
	mov r1, midColor
	jmpu b14, done
low_path:
	mov r1, lowColor
	jmpu b14, done
high_path:
	mov r1, highColor
done:
	min outclr, ones, r1
	end
.end
