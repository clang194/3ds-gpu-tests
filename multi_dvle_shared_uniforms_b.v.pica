.fvec projection[4], sharedColor, sharedBias, transformB[4], normalMtx[3]
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outview view
.out outnq normalquat
.alias inpos v0
.alias innrm v1
.entry main_b
.proc main_b
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, transformB[0], r0
	dp4 r1.y, transformB[1], r0
	dp4 r1.z, transformB[2], r0
	dp4 r1.w, transformB[3], r0
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mov r2.xyz, innrm
	mov r2.w, zeros
	dp4 r3.x, normalMtx[0], r2
	dp4 r3.y, normalMtx[1], r2
	dp4 r3.z, normalMtx[2], r2
	mov r3.w, zeros
	dp3 r4, r3, r3
	rsq r4, r4
	mul r3, r4, r3
	mov r15, sharedBias
	mad r5, r3, sharedColor, r15
	max r5, zeros, r5
	min outclr, ones, r5
	mov outview, r1
	mov outnq.xyz, r3
	mov outnq.w, ones
	end
.end
