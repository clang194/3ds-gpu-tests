.gsh point c0
.fvec projection[4], steps[3], finalFan[2]
.consti emitLoop(3, 0, 1, 0)
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.entry gmain
.proc gmain
	mov r8, v0
	for emitLoop
		add r8, steps[aL], r8
	.end
	mov r9, v1
	mov r10, v2
	setemit 0
	call emit_vertex
	emit
	setemit 1
	add r8, finalFan[0], r8
	call emit_vertex
	emit
	setemit 2, prim
	add r8, finalFan[1], r8
	call emit_vertex
	emit
	end
.end
.proc emit_vertex
	dp4 outpos.x, projection[0], r8
	dp4 outpos.y, projection[1], r8
	dp4 outpos.z, projection[2], r8
	dp4 outpos.w, projection[3], r8
	mov outclr, r9
	mov outtc0, r10
.end
