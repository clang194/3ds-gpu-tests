.gsh point c0
.fvec projection[4], offsets[6], altColor
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.entry gmain
.proc gmain
	mov r9, v1
	mov r10, v2
	dp4 r0.x, v3, v3
	mov r15, basis.wwww
	cmp r0, gt, le, r15
	call emit_first
	callc cmp.x, emit_second
	callc !cmp.x, emit_alt_second
	end
.end
.proc emit_first
	setemit 0
	add r8, offsets[0], v0
	call emit_vertex
	emit
	setemit 1
	add r8, offsets[1], v0
	call emit_vertex
	emit
	setemit 2, prim
	add r8, offsets[2], v0
	call emit_vertex
	emit
.end
.proc emit_second
	setemit 0
	add r8, offsets[3], v0
	call emit_vertex
	emit
	setemit 1
	add r8, offsets[4], v0
	call emit_vertex
	emit
	setemit 2, prim inv
	add r8, offsets[5], v0
	call emit_vertex
	emit
.end
.proc emit_alt_second
	mov r9, altColor
	setemit 0
	add r8, offsets[5], v0
	call emit_vertex
	emit
	setemit 1
	add r8, offsets[4], v0
	call emit_vertex
	emit
	setemit 2, prim
	add r8, offsets[3], v0
	call emit_vertex
	emit
.end
.proc emit_vertex
	dp4 outpos.x, projection[0], r8
	dp4 outpos.y, projection[1], r8
	dp4 outpos.z, projection[2], r8
	dp4 outpos.w, projection[3], r8
	mov outclr, r9
	mov outtc0, r10
.end
