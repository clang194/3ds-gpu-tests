.fvec projection[4], route0, route1, route2, route3
.bool select1, select2
.constf basis(0.0, 1.0, -1.0, 0.25)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.alias inpos v0
.alias inarg v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov r1, inarg
	mov r15, basis.wwww
	cmp r1, gt, lt, r15
	ifc cmp.x
		callu select1, path0
		ifu select2
			call path1
		.else
			call path2
		.end
	.else
		callc cmp.y, path3
		callc !cmp.y, path2
	.end
	max r1, zeros, r1
	min outclr, ones, r1
	end
.end
.proc path0
	mov r14, route0
	mad r1, r1, basis.wwww, r14
.end
.proc path1
	mov r14, route1
	mad r1, r1, r14, route2
.end
.proc path2
	mov r14, route2
	mad r1, r1, basis.wwww, r14
.end
.proc path3
	mov r14, route3
	mad r1, r1, basis.wwww, r14
.end
