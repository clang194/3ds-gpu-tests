.fvec projection[4], boneMtx[8], colorA, colorB
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outnq normalquat
.alias inpos v0
.alias innrm v1
.alias inidx v2
.entry skin_a
.proc skin_a
	mov r0.xyz, inpos
	mov r0.w, ones
	mova a0.x, inidx.x
	dp4 r1.x, boneMtx[a0.x+0], r0
	dp4 r1.y, boneMtx[a0.x+1], r0
	dp4 r1.z, boneMtx[a0.x+2], r0
	mov r1.w, ones
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mov r8.xyz, innrm
	mov r8.w, zeros
	call shared_norm_r8_r9
	mov r14, zeros
	mov r15, ones
	call shared_clamp_r9_r10
	mov outnq.xyz, r9
	mov outnq.w, ones
	mov r8, colorA
	mov r9, colorB
	call shared_lerp_r8_r9_r10
	mov outclr, r10
	end
.end
