.gsh variable c48 3
.fvec projection[4]
.constf basis(0.0, 1.0, -1.0, 4.0)
.constf uv0(0.0, 0.0, 0.0, 1.0)
.constf uv1(1.0, 0.0, 0.0, 1.0)
.constf uv2(0.5, 1.0, 0.0, 1.0)
.out outpos position
.out outclr color
.out outtc0 texcoord0
.entry gmain
.proc gmain
	mov r14, c0
	mov r15, basis.wwww
	cmp r14, ge, lt, r15
	jmpc cmp.y, done
	setemit 0
	mov r8, c1
	mov r9, c2
	mov r10, uv0
	call emit_vertex
	emit
	setemit 1
	mov r8, c4
	mov r9, c5
	mov r10, uv1
	call emit_vertex
	emit
	setemit 2, prim
	mov r8, c7
	mov r9, c8
	mov r10, uv2
	call emit_vertex
	emit
	setemit 0
	mov r8, c1
	mov r9, c2
	mov r10, uv0
	call emit_vertex
	emit
	setemit 1
	mov r8, c7
	mov r9, c8
	mov r10, uv2
	call emit_vertex
	emit
	setemit 2, prim inv
	mov r8, c10
	mov r9, c5
	mov r10, uv1.yxzw
	call emit_vertex
	emit
done:
	end
.end
.proc emit_vertex
	dp4 outpos.x, projection[0], r8
	dp4 outpos.y, projection[1], r8
	dp4 outpos.z, projection[2], r8
	dp4 outpos.w, projection[3], r8
	mov outclr, r9
	mov outtc0, r10
.end
