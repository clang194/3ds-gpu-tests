.fvec projection[4], block[24]
.constf basis(0.0, 1.0, -1.0, 0.25)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inidx v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	mova a0.x, inidx.x
	dp4 r1.x, block[a0.x+0], r0
	dp4 r1.y, block[a0.x+1], r0
	dp4 r1.z, block[a0.x+2], r0
	dp4 r1.w, block[a0.x+3], r0
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	add r2, basis.wwww, inidx
	mova a0.y, r2.y
	mov r3, block[a0.y+8]
	mov r4, block[a0.y+12]
	add r5, r3, r4
	max r5, zeros, r5
	min outclr, ones, r5
	mov outtc0.xy, r1.xy
	mov outtc0.zw, r5.zw
	end
.end
