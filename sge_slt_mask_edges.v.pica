.fvec projection[4], lowClip, highClip, passColor, failColor
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.alias inpos v0
.alias inarg v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	sge r1, inarg, lowClip
	slt r2, inarg, highClip
	mul r3, r1, r2
	dp4 r4.x, basis.yyyy, r3
	mov r15, basis.wwww
	cmp r4, ge, lt, r15
	ifc cmp.x && !cmp.y
		mov r5, passColor
	.else
		mov r5, failColor
	.end
	min outclr, ones, r5
	end
.end
