.fvec projection[4], modelView[4], normalMtx[3], tangentMtx[3]
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outview view
.out outnq normalquat
.alias inpos v0
.alias innrm v1
.alias intan v2
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mov r2.xyz, innrm
	mov r2.w, zeros
	dp4 r3.x, normalMtx[0], r2
	dp4 r3.y, normalMtx[1], r2
	dp4 r3.z, normalMtx[2], r2
	mov r3.w, zeros
	dp3 r4, r3, r3
	rsq r4, r4
	mul r3, r4, r3
	mov r5.xyz, intan
	mov r5.w, zeros
	dp4 r6.x, tangentMtx[0], r5
	dp4 r6.y, tangentMtx[1], r5
	dp4 r6.z, tangentMtx[2], r5
	dp3 r7.x, r3, r6
	add r7.y, zeros, -r7.xxxx
	max r8, zeros, r7
	min outclr, ones, r8
	mov outnq.xyz, r3
	mov outnq.w, r7.y
	mov outview.xyz, r1
	mov outview.w, ones
	end
.end
