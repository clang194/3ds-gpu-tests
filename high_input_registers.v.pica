.fvec projection[4], mixA, mixB, colorBias
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.alias inpos v8
.alias inclr v9
.alias intc v10
.alias inaux v11
.out outpos position
.out outclr color
.out outtc0 texcoord0
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	mov r1, inclr
	mov r2, intc
	mov r3, inaux
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mul r4, mixA, r1
	mad r4, r3, mixB, r4
	add r4, colorBias, r4
	max r4, zeros, r4
	min outclr, ones, r4
	mov outtc0, r2
	end
.end
