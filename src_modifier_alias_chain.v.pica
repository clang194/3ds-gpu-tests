.fvec projection[4], scaleA, scaleB, bias
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.alias pos_yzx v0.yzxw
.alias clr_bgra v1.bgra
.alias tc_wzyx v2.wzyx
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.entry main
.proc main
	mov r0.xyz, pos_yzx.zxy
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mul r1, scaleA, clr_bgra
	mov r15, bias
	mad r1, r1, scaleB, r15
	max r1, zeros, r1
	min outclr, ones, r1
	mov outtc0.xy, tc_wzyx.zw
	mov outtc0.zw, tc_wzyx.xy
	end
.end
