.gsh point c0
.fvec projection[4], offsets[3], colorScale
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0.xy
.out - texcoord0w outtc0.z
.out outview view.xyz
.out outnq normalquat
.entry gmain
.proc gmain
	mov r9, v1
	mov r10, v2
	mov r11, v3
	setemit 0
	add r8, offsets[0], v0
	call emit_vertex
	emit
	setemit 1
	add r8, offsets[1], v0
	call emit_vertex
	emit
	setemit 2, prim
	add r8, offsets[2], v0
	call emit_vertex
	emit
	end
.end
.proc emit_vertex
	dp4 outpos.x, projection[0], r8
	dp4 outpos.y, projection[1], r8
	dp4 outpos.z, projection[2], r8
	dp4 outpos.w, projection[3], r8
	mul r12, colorScale, r9
	min outclr, ones, r12
	mov outtc0.xy, r10.xy
	mov outtc0.zw, r10.zw
	mov outview.xyz, r11.xyz
	mov outnq.xyz, r11.zyx
	mov outnq.w, ones
.end
