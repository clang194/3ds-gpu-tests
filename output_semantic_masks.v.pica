.fvec projection[4], texMtx[2], viewMtx[3]
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0.xy
.out - texcoord0w outtc0.z
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outview view.xyz
.out outnq normalquat
.alias inpos v0
.alias innrm v1
.alias intc v2
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	dp4 outtc0.x, texMtx[0], intc
	dp4 outtc0.y, texMtx[1], intc
	mov outtc0.zw, basis.xy
	mov outtc1.xy, intc.zw
	mov outtc1.zw, basis.yx
	mov outtc2, intc.wzyx
	mov r1.xyz, innrm
	mov r1.w, zeros
	dp4 outview.x, viewMtx[0], r1
	dp4 outview.y, viewMtx[1], r1
	dp4 outview.z, viewMtx[2], r1
	dp3 r2, r1, r1
	rsq r2, r2
	mul r3, r1, r2
	mov outnq.xyz, r3
	mov outnq.w, ones
	max r4, zeros, r3
	min outclr, ones, r4
	end
.end
