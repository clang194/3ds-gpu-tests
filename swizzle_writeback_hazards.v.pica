.fvec projection[4], mixA, mixB, mixC
.constf basis(0.0, 1.0, -1.0, 0.3333333432674408)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inarg v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov r1, inarg
	add r1.xy, mixA.xyxy, r1.zwzw
	mul r1.zw, mixB.zwzw, r1.yxyx
	mad r1.xz, r1.wwyy, mixC.xzyw, r1.yyxx
	add r2, r1.wzyx, -r1.xyzw
	max r3, zeros, r2
	min r4, ones, r3
	mov outclr, r4
	mov outtc0.xy, r1.xy
	mov outtc0.zw, r2.zw
	end
.end
