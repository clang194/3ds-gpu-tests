.fvec projection[4], inv255, gammaScale, gammaBias
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inrgba v1
.alias intc v2
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	flr r1, inrgba
	mul r2, inv255, r1
	mul r3, r2, r2
	mov r15, gammaBias
	mad r4, r3, gammaScale, r15
	max r4, zeros, r4
	min outclr, ones, r4
	mov outtc0, intc
	end
.end
