.fvec projection[4]
.constf base(0.0, 1.0, 2.0, 4.0)
.constf scale(0.25, 0.5, 0.75, 1.0)
.alias zeros base.xxxx
.alias ones base.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inparam v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	max r1, scale, inparam
	rcp r2, r1.xxxx
	rsq r3, r1.yyyy
	lg2 r4, r1.zzzz
	ex2 r5, r4
	flr r6, r5
	add r7, r5, -r6
	mul r8, r2, r3
	mad r8, r7, scale, r8
	min outclr, ones, r8
	mov outtc0.xy, r4.xy
	mov outtc0.zw, base.xy
	end
.end
