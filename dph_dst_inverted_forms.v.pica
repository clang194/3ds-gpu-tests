.fvec projection[4], affine[3], dstSeed, colorA, colorB
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inaux v1
.alias intc v2
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dph r1.x, r0, affine[0]
	dph r1.y, r0, affine[1]
	dph r1.z, r0, affine[2]
	mov r1.w, ones
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mov r2, inaux
	dst r3, r2, dstSeed
	dst r4, dstSeed, r2
	add r5, r3, -r4
	mov r8, colorA
	mov r9, colorB
	add r10, r9, -r8
	mad r11, r5, r10, r8
	max r11, zeros, r11
	min outclr, ones, r11
	mov outtc0, intc
	end
.end
