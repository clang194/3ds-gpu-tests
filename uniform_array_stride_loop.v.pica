.fvec projection[4], block[20], colors[10]
.consti loopSpec(5, 0, 1, 0)
.constf basis(0.0, 1.0, -1.0, 0.2)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias intc v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	mov r1, zeros
	for loopSpec
		dp4 r2.x, block[aL+0], r0
		dp4 r2.y, block[aL+5], r0
		dp4 r2.z, block[aL+10], r0
		dp4 r2.w, block[aL+15], r0
		mad r1, r2, colors[aL], r1
	.end
	mul r1, basis.wwww, r1
	max r1, zeros, r1
	min outclr, ones, r1
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov outtc0, intc
	end
.end
