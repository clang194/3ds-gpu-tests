.fvec projection[4], bucketNear, bucketMid, bucketFar
.constf basis(0.0, 1.0, -1.0, 0.5)
.constf thresholds(0.125, 0.5, 2.0, 8.0)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.alias inpos v0
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, projection[0], r0
	dp4 r1.y, projection[1], r0
	dp4 r1.z, projection[2], r0
	dp4 r1.w, projection[3], r0
	mov outpos, r1
	rcp r2, r1.zzzz
	mov r15, thresholds
	cmp r2, gt, lt, r15
	ifc cmp.x
		mov r3, bucketNear
	.else
		mov r15, thresholds.yyyy
		cmp r2, gt, lt, r15
		ifc cmp.x
			mov r3, bucketMid
		.else
			mov r3, bucketFar
		.end
	.end
	min outclr, ones, r3
	end
.end
