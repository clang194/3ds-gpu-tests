.fvec projection[4], colorBase
.setf c90(0.125, 0.25, 0.5, 1.0)
.seti i3(5, 0, 1, 0)
.setb b14 true
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.alias scale c90
.out outpos position
.out outclr color
.alias inpos v0
.alias inarg v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov r1, inarg
	ifu b14
		mov r14, colorBase
		for i3
			mad r1, r1, scale, r14
			min r1, ones, r1
		.end
	.else
		mov r1, colorBase
	.end
	min outclr, ones, r1
	end
.end
