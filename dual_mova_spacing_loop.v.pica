.fvec projection[4], tableA[12], tableB[12], tableC[12]
.consti loopSpec(4, 0, 1, 0)
.constf basis(0.0, 1.0, -1.0, 0.25)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inidx v1
.alias intc v2
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	mov r6, zeros
	for loopSpec
		add r1, tableC[aL], inidx
		mova a0.x, r1.x
		dp4 r2.x, tableA[a0.x], r0
		add r3, basis.wwww, r1
		mova a0.y, r3.y
		dp4 r2.y, tableB[a0.y], r0
		add r2.zw, basis.wwww, r2.xyxy
		mad r6, r2, tableC[aL], r6
	.end
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	max r6, zeros, r6
	min outclr, ones, r6
	mov outtc0, intc
	end
.end
