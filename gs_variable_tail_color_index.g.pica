.gsh variable c56 3
.fvec projection[4], palette[8]
.constf basis(0.0, 1.0, -1.0, 0.5)
.constf uv0(0.0, 0.0, 0.0, 1.0)
.constf uv1(1.0, 0.0, 0.0, 1.0)
.constf uv2(0.5, 1.0, 0.0, 1.0)
.out outpos position
.out outclr color
.out outtc0 texcoord0
.entry gmain
.proc gmain
	mova a0.x, c0.x
	mov r11, c1[a0.x]
	mov r15, c5
	add r12, c2, r15
	mov r15, c8
	add r12, r12, r15
	mul r12, basis.wwww, r12
	mova a0.y, r11.x
	setemit 0
	mov r8, c1
	mov r9, palette[a0.y]
	mov r10, uv0
	call emit_vertex
	emit
	setemit 1
	mov r8, c4
	mov r9, palette[a0.y+1]
	mov r10, uv1
	call emit_vertex
	emit
	setemit 2, prim
	mov r8, r12
	mov r9, palette[a0.y+2]
	mov r10, uv2
	call emit_vertex
	emit
	end
.end
.proc emit_vertex
	dp4 outpos.x, projection[0], r8
	dp4 outpos.y, projection[1], r8
	dp4 outpos.z, projection[2], r8
	dp4 outpos.w, projection[3], r8
	mov outclr, r9
	mov outtc0, r10
.end
