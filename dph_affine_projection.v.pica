.fvec projection[4], affine[3], colorScale, depthBias
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inclr v1
.alias intc v2
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dph r1.x, affine[0], r0
	dph r1.y, affine[1], r0
	dph r1.z, affine[2], r0
	mov r1.w, ones
	mov r15, depthBias
	add r1, r1, r15
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mul r2, colorScale, inclr
	max r2, zeros, r2
	min outclr, ones, r2
	mov outtc0, intc
	end
.end
