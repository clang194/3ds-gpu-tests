.fvec projection[4], tableA[16], tableB[16]
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inidx v1
.alias inarg v2
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mova a0.x, inidx.x
	dp4 r1.x, tableA[a0.x], r0
	add r2, basis.wwww, inidx
	mova a0.y, r2.y
	dp4 r1.y, tableB[a0.y], inarg
	mov r15, tableB[a0.y+1]
	add r3, tableA[a0.x+1], r15
	mad r4, r1.xxxx, r3, r1.yyyy
	max r4, zeros, r4
	min outclr, ones, r4
	mov outtc0.xy, r1.xy
	mov outtc0.zw, basis.xy
	end
.end
