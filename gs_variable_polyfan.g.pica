.gsh variable c48 3
.fvec projection[4]
.constf basis(0.0, 1.0, -1.0, 3.0)
.constf texseed(0.0, 0.5, 1.0, 1.0)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.entry gmain
.proc gmain
	mov r14, c0
	mov r15, basis.wwww
	cmp r14, gt, ge, r15
	ifc cmp.x || cmp.y
		mova a0.x, c0.x
		mov r11, c1[a0.x]
		setemit 0
		mov r8, c1
		mov r9, c2
		mov r10, texseed
		call emit_vertex
		emit
		setemit 1
		mov r8, c4
		mov r9, c5
		mov r10, texseed.yxzw
		call emit_vertex
		emit
		setemit 2, prim
		mov r8, c7
		add r8, r8, r11
		mov r9, c8
		mov r10, texseed.zyxw
		call emit_vertex
		emit
	.else
		setemit 0
		mov r8, c1
		mov r9, c2
		mov r10, texseed
		call emit_vertex
		emit
		setemit 1
		mov r8, c4
		mov r9, c5
		mov r10, texseed.yxzw
		call emit_vertex
		emit
		setemit 2, prim
		mov r8, c1
		mov r9, c8
		mov r10, texseed.zyxw
		call emit_vertex
		emit
	.end
	end
.end
.proc emit_vertex
	dp4 outpos.x, projection[0], r8
	dp4 outpos.y, projection[1], r8
	dp4 outpos.z, projection[2], r8
	dp4 outpos.w, projection[3], r8
	mov outclr, r9
	mov outtc0, r10
.end
