.fvec projection[4], sharedColor, sharedBias, transformA[4]
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inclr v1
.alias intc v2
.entry main_a
.proc main_a
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, transformA[0], r0
	dp4 r1.y, transformA[1], r0
	dp4 r1.z, transformA[2], r0
	dp4 r1.w, transformA[3], r0
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mov r15, sharedBias
	mad r2, inclr, sharedColor, r15
	max r2, zeros, r2
	min outclr, ones, r2
	mov outtc0, intc
	end
.end
