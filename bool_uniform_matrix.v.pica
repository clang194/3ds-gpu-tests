.fvec projection[4], colorA, colorB, colorC, colorD
.bool route[4]
.constf basis(0.0, 1.0, -1.0, 0.25)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.alias inpos v0
.alias inarg v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov r1, inarg
	ifu route[0]
		call apply_a
	.end
	ifu route[1]
		call apply_b
	.end
	callu route[2], apply_c
	jmpu !route[3], finish
	call apply_d
finish:
	max r1, zeros, r1
	min outclr, ones, r1
	end
.end
.proc apply_a
	mov r15, colorA
	mad r1, r1, basis.wwww, r15
.end
.proc apply_b
	mov r15, colorB
	mad r1, r1, r15, colorC
.end
.proc apply_c
	mov r15, colorC
	mad r1, r1, basis.wwww, r15
.end
.proc apply_d
	mov r15, colorD
	mad r1, r1, basis.wwww, r15
.end
