.fvec projection[4], palette[16], baseColor
.constf basis(0.0, 1.0, -1.0, 0.5)
.alias zeros basis.xxxx
.alias ones basis.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inidx v1
.entry main
.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	flr r1, inidx
	add r2, inidx, -r1
	mova a0.x, r1.x
	mov r3, palette[a0.x]
	mov r15, baseColor
	mad r4, r2, r3, r15
	max r4, zeros, r4
	min outclr, ones, r4
	mov outtc0.xy, r2.xy
	mov outtc0.zw, r1.zw
	end
.end
